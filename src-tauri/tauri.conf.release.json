{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxiva Voice",
  "version": "0.1.0",
  "identifier": "ai.voxiva.voice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voxiva Voice",
        "width": 440,
        "height": 780,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Voice dictation for developers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/voxiva-ai/voxiva-voice/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RTRCQjY2RDk0MTc2MEEKUldRS2RrSFpacnZrU1A3cDdEV09xemtzakF5ek1yUFFmSGZwTHdyb3VDdGw5b2dMQWVyZXdYVmIK"
    }
  }
}

